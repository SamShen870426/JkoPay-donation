generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum DonationCategory {
  groups
  projects
  products
}

enum CharityTheme {
  child_youth_care
  animal_protection
  special_medical
  elderly_care
  disability_services
  women_care
  sports_development
  education_advocacy
  environmental_protection
  multicultural
  media_communication
  public_issues
  culture_arts
  community_development
  poverty_relief
  international_relief
}

/// 捐款項目可關聯多個「公益主題」（與篩選 sheet 同一套 CharityTheme）
model DonationItemTheme {
  donationItemId Int          @map("donation_item_id")
  theme          CharityTheme
  sortOrder      Int          @default(0) @map("sort_order")

  donationItem DonationItem @relation(fields: [donationItemId], references: [id], onDelete: Cascade)

  @@id([donationItemId, theme])
  @@index([theme, donationItemId])
  @@map("donation_item_themes")
}

model DonationItem {
  id                 Int              @id @default(autoincrement())
  category           DonationCategory
  titleZh            String           @map("title_zh") @db.VarChar(255)
  summaryZh          String           @map("summary_zh") @db.VarChar(512)
  logoKey            String           @map("logo_key") @db.VarChar(512)
  /// 捐款專案卡：所屬團體（紅字）
  organizationNameZh String?          @map("organization_name_zh") @db.VarChar(255)
  /// 捐款專案卡：頂部大圖（與 logo 分離）
  heroImageKey       String?          @map("hero_image_key") @db.VarChar(512)
  createdAt          DateTime         @default(now()) @map("created_at")

  itemThemes DonationItemTheme[]

  @@index([category, id])
  @@map("donation_items")
}
