generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum DonationCategory {
  groups
  projects
  products
}

/// 捐款專案結帳可選類型（主檔為 enum；各專案以關聯列決定開放哪些）
enum ProjectDonationPaymentKind {
  recurring_monthly
  one_time
}

enum CharityTheme {
  child_youth_care
  animal_protection
  special_medical
  elderly_care
  disability_services
  women_care
  sports_development
  education_advocacy
  environmental_protection
  multicultural
  media_communication
  public_issues
  culture_arts
  community_development
  poverty_relief
  international_relief
}

/// 公益團體主檔（列表／個人頁／綁定專案與義賣）
model CharityOrganization {
  id                   Int    @id @default(autoincrement())
  nameZh               String @map("name_zh") @db.VarChar(255)
  logoKey              String @map("logo_key") @db.VarChar(512)
  /// 個人頁頂部背景圖（可空，前端可用純色代替）
  profileBannerKey     String? @map("profile_banner_key") @db.VarChar(512)
  phone                String? @map("phone") @db.VarChar(64)
  email                String? @map("email") @db.VarChar(255)
  websiteUrl           String? @map("website_url") @db.VarChar(512)
  registrationNumberZh String? @map("registration_number_zh") @db.VarChar(255)
  descriptionZh        String @map("description_zh") @db.Text
  createdAt            DateTime @default(now()) @map("created_at")

  themes          CharityOrganizationTheme[]
  donationItems   DonationItem[]
  charityProducts CharityProduct[]

  @@map("charity_organizations")
}

/// 團體個人頁「分類」標籤（與篩選 CharityTheme 同一套）
model CharityOrganizationTheme {
  organizationId Int          @map("organization_id")
  theme          CharityTheme
  sortOrder      Int          @default(0) @map("sort_order")

  organization CharityOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, theme])
  @@index([theme, organizationId])
  @@map("charity_organization_themes")
}

/// 捐款項目可關聯多個「公益主題」（與篩選 sheet 同一套 CharityTheme）
model DonationItemTheme {
  donationItemId Int          @map("donation_item_id")
  theme          CharityTheme
  sortOrder      Int          @default(0) @map("sort_order")

  donationItem DonationItem @relation(fields: [donationItemId], references: [id], onDelete: Cascade)

  @@id([donationItemId, theme])
  @@index([theme, donationItemId])
  @@map("donation_item_themes")
}

/// 捐款專案詳情頂部輪播圖
model DonationProjectHeroImage {
  id             Int    @id @default(autoincrement())
  donationItemId Int    @map("donation_item_id")
  imageKey       String @map("image_key") @db.VarChar(512)
  sortOrder      Int    @default(0) @map("sort_order")
  isPrimary      Boolean @default(false) @map("is_primary")

  donationItem DonationItem @relation(fields: [donationItemId], references: [id], onDelete: Cascade)

  @@index([donationItemId, sortOrder])
  @@map("donation_project_hero_images")
}

/// 捐款專案可選的付款類型（列存在即 true）
model DonationItemProjectPaymentOption {
  donationItemId Int                      @map("donation_item_id")
  kind           ProjectDonationPaymentKind

  donationItem DonationItem @relation(fields: [donationItemId], references: [id], onDelete: Cascade)

  @@id([donationItemId, kind])
  @@map("donation_item_project_payment_options")
}

model DonationItemBillingDay {
  id             Int @id @default(autoincrement())
  donationItemId Int @map("donation_item_id")
  dayOfMonth     Int @map("day_of_month")
  sortOrder      Int @default(0) @map("sort_order")

  donationItem DonationItem @relation(fields: [donationItemId], references: [id], onDelete: Cascade)

  @@index([donationItemId, sortOrder])
  @@map("donation_item_billing_days")
}

model DonationItemAmountPreset {
  id             Int    @id @default(autoincrement())
  donationItemId Int    @map("donation_item_id")
  amount         Int
  currency       String @default("TWD") @db.VarChar(8)
  sortOrder      Int    @default(0) @map("sort_order")

  donationItem DonationItem @relation(fields: [donationItemId], references: [id], onDelete: Cascade)

  @@index([donationItemId, sortOrder])
  @@map("donation_item_amount_presets")
}

model DonationItem {
  id                 Int              @id @default(autoincrement())
  category           DonationCategory
  titleZh            String           @map("title_zh") @db.VarChar(255)
  summaryZh          String           @map("summary_zh") @db.VarChar(512)
  logoKey            String           @map("logo_key") @db.VarChar(512)
  /// 捐款專案卡：所屬團體（紅字）；若已綁 organizationId 可與主檔並存供過渡
  organizationNameZh String?          @map("organization_name_zh") @db.VarChar(255)
  /// 捐款專案卡：頂部大圖（與 logo 分離）
  heroImageKey       String?          @map("hero_image_key") @db.VarChar(512)
  /// 勸募／立案核准字號（專案詳情灰字列）
  fundraisingLicenseZh String?        @map("fundraising_license_zh") @db.VarChar(64)
  /// 專案詳情內文（長文）
  projectDetailZh    String?          @map("project_detail_zh") @db.Text
  /// 專案頁底部淺灰聲明
  projectDisclaimerZh String?        @map("project_disclaimer_zh") @db.Text
  /// 綁定公益團體主檔。原則：每個 CharityOrganization 應至少有一筆 category=groups 列且帶此欄，列表與關鍵字搜尋才會命中團名；義賣／專案列亦應與主檔一致。
  organizationId     Int?             @map("organization_id")
  createdAt          DateTime         @default(now()) @map("created_at")

  organization   CharityOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  itemThemes     DonationItemTheme[]
  /// 義賣商品擴充（僅 category=products 時使用，1:1）
  charityProduct CharityProduct?
  /// 捐款專案：輪播大圖（可空，詳情 API 可退回 heroImageKey）
  projectHeroImages DonationProjectHeroImage[]
  /// 捐款專案：開放的付款類型（列存在即開放）
  projectPaymentOptions DonationItemProjectPaymentOption[]
  /// 捐款專案：定期扣款可選日（每月幾號）
  billingDays    DonationItemBillingDay[]
  /// 捐款專案：建議金額
  amountPresets  DonationItemAmountPreset[]

  @@index([category, id])
  @@index([organizationId, category, id])
  @@map("donation_items")
}

/// 義賣商品：圖片／選項／運費等（列表價格區間由 options 的單價 min/max 推導）
model CharityProduct {
  id              Int    @id @default(autoincrement())
  donationItemId  Int    @unique @map("donation_item_id")
  organizationId  Int    @map("organization_id")
  /// 商品說明（詳情頁用）
  descriptionZh   String @map("description_zh") @db.Text
  currency        String @default("TWD") @db.VarChar(8)
  /// 運費（與單價同單位：整數，TWD 為元）
  shippingFeeAmount Int    @default(0) @map("shipping_fee_amount")

  donationItem DonationItem            @relation(fields: [donationItemId], references: [id], onDelete: Cascade)
  organization CharityOrganization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  images       CharityProductImage[]
  options      CharityProductOption[]

  @@index([organizationId])
  @@map("charity_products")
}

model CharityProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  imageKey  String  @map("image_key") @db.VarChar(512)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  product CharityProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("charity_product_images")
}

model CharityProductOption {
  id               Int    @id @default(autoincrement())
  productId        Int    @map("product_id")
  labelZh          String @map("label_zh") @db.VarChar(255)
  /// 單價（TWD 為元，整數）
  unitPriceAmount  Int    @map("unit_price_amount")
  stockQuantity    Int    @map("stock_quantity")
  sortOrder        Int    @default(0) @map("sort_order")

  product CharityProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("charity_product_options")
}
